# Every environment variable the app, the scripts and the ops scripts read. No values here: fill your own.
# Local runs: copy to .env.local (dev-server.mjs and scripts/*.mjs read it; empty lines fall back to the defaults below).
# Ops scripts read the shell environment: `set -a; . ./.env.local; set +a` before running them.
# On Vercel: Project → Settings → Environment Variables. VERCEL itself is set by the platform; keep it unset locally.

# ---------- app (api/) ----------
# Upstash Redis. Vercel's Upstash integration fills the KV_ pair; the UPSTASH_ pair works too.
# Without either pair the app uses the local file store .data/dev-store.json (fine for dev, never for the event).
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# the one password an event needs: operator key for /console?key=… and /led?key=…
# unset locally means 'dev-admin'; unset on Vercel locks the console and judging
ADMIN_KEY=
# optional. Without it each judge's link key is derived from ADMIN_KEY and the console lists the links (도구 → VC 심사 링크).
# Set it to pin the links yourself: JSON, one key per judge in public/assets/event.js, {"vc1":"…","vc2":"…"} → /judge?k=<key>
VC_KEYS=
# optional. Salt for the email hashes that identify teams; without it the salt is derived from ADMIN_KEY ('dev-salt' locally).
# scripts/build-seed.py applies the same rule. Changing ADMIN_KEY mid-event changes both; set these two to pin them.
EMAIL_SALT=
# Discord webhooks the server posts to: submissions and topic declarations / results (empty = no posts)
DISCORD_WEBHOOK_SUBMIT=
DISCORD_WEBHOOK_RESULT=
# optional: exact commit counts and a higher GitHub rate limit (without it the public commit feed is used)
GITHUB_TOKEN=
# Vercel Blob store for pitch PDF uploads (Vercel fills it when you connect a Blob store)
BLOB_READ_WRITE_TOKEN=
# dev server port (default 4400); the scripts use it for their default base URL too
PORT=

# ---------- ops scripts (ops/*.py, Python 3, stdlib only) ----------
# the app the scripts talk to, e.g. https://your-hackathon.vercel.app (default http://localhost:4400); they also use ADMIN_KEY
HACKATHON_BASE_URL=
# Discord bot (needs read and send in both rooms) and the rooms it watches and posts to
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
PARTICIPANT_CHANNEL_ID=
# the VC + staff room
OPS_CHANNEL_ID=
# staff Discord user ids, comma-separated: qna_watch.py skips their messages
STAFF_USER_IDS=
# signature on bot posts (default 'Bloom Ops')
OPS_NAME=
# where qna_watch.py and sub_ping.py remember what they have seen (default ~/.hackathon-ops)
OPS_STATE_DIR=
# backup.py: snapshot folder (default ~/.hackathon-ops/backups) and the last day it should run (YYYY-MM-DD)
BACKUP_DIR=
STOP_AFTER=
# autoreveal.py: DRY_RUN=1 prints its Discord posts instead of sending them (reveals still happen); seconds between reveals (22); ms a result stays on the LED (21000)
DRY_RUN=
REVEAL_GAP_SEC=
REVEAL_SHOW_MS=
# autoreveal.py repechage window, ISO times (default: submit deadline, +1h, and stop at +3h)
REPECHAGE_AT=
REPECHAGE_HARD_AT=
AUTOREVEAL_STOP_AT=
# sub_ping.py stops at this ISO time (default 2h after the submit deadline); offer_notify.py runs this many hours (3)
SUB_PING_UNTIL=
OFFER_NOTIFY_HOURS=
